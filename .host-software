# .host-software — the Where room recipe (read by `host-lifecycle software`).
# One [software "<name>"] stanza per embedded component. `--materialize` clones
# the bare store + worktrees from `url` at `pin`; `--check` audits each worktree
# against its recorded pin. The trees live under /software/ and are gitignored;
# this committed recipe (the pin) is the reproducibility anchor.

[software "es1969"]
	url          = https://github.com/slartibardfast/es1969.git
	branch       = main
	pin          = cf248f83bc8cef5adbfefe5c429d6b377f1b6efb
	# Migrated software: a self-signed ES1969 / gameport kernel driver built with
	# the Windows WDK (SOURCES/DIRS, vs2019 .sln). It is not byte-reproducible on a
	# Linux host, so it carries the escape clause until the build is pinned. See:
	repro-exempt = call/0001
